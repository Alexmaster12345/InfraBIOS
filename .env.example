# InfraBIOS Server — copy to .env and edit

# Listen address (default: :8080)
INFRABIOS_ADDR=:8080

# PostgreSQL connection string
INFRABIOS_DATABASE_URL=postgres://infrabios:infrabios@localhost:5432/infrabios?sslmode=disable

# Comma-separated operator API tokens
# Generate: openssl rand -hex 32
INFRABIOS_API_TOKENS=changeme

# Token used by agents to submit inventory
INFRABIOS_AGENT_TOKEN=agent-changeme

# Log level: debug | info | warn | error
INFRABIOS_LOG_LEVEL=info

# --- Agent config (used by cmd/agent) ---
INFRABIOS_SERVER_URL=http://localhost:8080
INFRABIOS_SERVER_ID=          # UUID assigned after first registration
INFRABIOS_COLLECT_INTERVAL=60s
